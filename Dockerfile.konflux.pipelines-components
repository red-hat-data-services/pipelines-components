FROM registry.redhat.io/ubi9/python-312@sha256:1918f356719985f9fdae68937d185ffe8a55aa39e00e6a0d07108a0ddd476d9b

USER root

# base image switch RHOAIENG-94184
RUN update-crypto-policies --set DEFAULT:PQ --no-reload

WORKDIR /app

ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml __init__.py ./
COPY components/ components/
COPY pipelines/ pipelines/
COPY scripts/ scripts/
COPY utils/ utils/

RUN chown -R 1001:1001 /app
USER 1001

RUN pip install --no-cache-dir --no-deps .

# Work around s390x segfault during cleanup by forcing immediate exit without cleanup
RUN python -c "import sys; sys.path.insert(0, '/app'); from scripts.generate_managed_pipelines.generate_managed_pipelines import main; import os; os._exit(main())"

CMD ["python", "-m", "scripts.init_managed_pipelines.init_managed_pipelines"]
